# ==============================================================================
# MailArchive - configurazione (.env.example)
# Copia questo file in `.env` e inserisci i valori reali SOLO sul tuo server.
# Il file `.env` e' escluso da git: non committarlo mai.
# ==============================================================================

# Ambiente applicativo: "production" abilita cookie Secure e HSTS-friendly
NODE_ENV=production
# URL pubblico dell'installazione, senza slash finale
APP_URL=https://mailarchive.example.com

# ------------------------------------------------------------------------------
# Database MariaDB / MySQL (oppure SQLite: DB_DRIVER=sqlite e DB_PATH=./mailarchive.db)
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=mailarchive
DB_USER=mailarchive_user
DB_PASS=""

# ------------------------------------------------------------------------------
# Segreti crittografici: genera ciascuno con `openssl rand -hex 32`
# Usa valori DIVERSI per ognuno. ENCRYPTION_KEY cifra le password IMAP salvate:
# se la perdi, le caselle configurate non sono piu' leggibili.
# ------------------------------------------------------------------------------
SESSION_SECRET=""
CSRF_SECRET=""
CRON_SECRET=""
ENCRYPTION_KEY=""

# ------------------------------------------------------------------------------
# Amministratore iniziale (creato da scripts/install.php o database/seed.php)
# ------------------------------------------------------------------------------
INITIAL_ADMIN_EMAIL="admin@example.com"
# Lascia vuoto per generarne una casuale; oppure: openssl rand -base64 24
INITIAL_ADMIN_PASSWORD=""

# Secondo fattore obbligatorio per tutti gli accessi (codice via email o TOTP)
REQUIRE_2FA=true

# ------------------------------------------------------------------------------
# Rate limiting e blocco account
# ------------------------------------------------------------------------------
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300

# Se l'app sta dietro un reverse proxy / CDN fidato (es. Cloudflare) elenca qui
# gli IP del proxy separati da virgola. Vuoto = gli header X-Forwarded-For e
# CF-Connecting-IP vengono ignorati.
TRUSTED_PROXIES=""

# ------------------------------------------------------------------------------
# Notifiche e codici 2FA via email (SMTP)
# ------------------------------------------------------------------------------
ALERT_SMTP_HOST=""
ALERT_SMTP_PORT=465
ALERT_SMTP_SECURE=true
ALERT_SMTP_USER=""
ALERT_SMTP_PASS=""
ALERT_FROM_EMAIL=""
ALERT_RECIPIENT_EMAIL=""
ALERT_WEBHOOK_URL=""

# ------------------------------------------------------------------------------
# Storage e sincronizzazione IMAP
# ------------------------------------------------------------------------------
STORAGE_DIR="./storage"
SYNC_CONCURRENCY=1
IMAP_CONNECTION_TIMEOUT=30000
IMAP_OPERATION_TIMEOUT=300000
